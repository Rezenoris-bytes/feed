generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  SUPER_ADMIN
  HR
  REVIEWER
  EMPLOYEE
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  ON_HOLD
  RESOLVED
  CLOSED
}

enum MessageAuthor {
  EMPLOYEE
  STAFF
}

// ---------- Authentication ----------
model User {
  id           String      @id @default(uuid()) @db.Char(36)
  email        String      @unique
  passwordHash String
  displayName  String
  isActive     Boolean     @default(true)
  mfaSecretEnc String?     @db.VarChar(255) // AES-GCM encrypted TOTP secret
  mfaEnabled   Boolean     @default(false)
  failedLogins Int         @default(0)
  lockedUntil  DateTime?
  departmentId String?     @db.Char(36)
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  roles         UserRole[]
  sessions      Session[]
  profile       EmployeeProfile?
  assignments   FeedbackAssignment[] @relation("assignee")
  notifications Notification[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  key         RoleKey          @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Char(36)
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Char(36)
  roleId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id          String    @id // sha256 of the cookie token, never the raw token
  userId      String    @db.Char(36)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified Boolean   @default(false)
  mfaAt       DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model Department {
  id        String               @id @default(uuid()) @db.Char(36)
  name      String               @unique
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  users     User[]
  feedback  FeedbackSubmission[]

  @@map("departments")
}

model EmployeeProfile {
  userId     String  @id @db.Char(36)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo String  @unique
  jobTitle   String?
  phoneEnc   String? // encrypted

  @@map("employee_profiles")
}

// ---------- Feedback (no user FK anywhere) ----------
model FeedbackCategory {
  id        String               @id @default(uuid()) @db.Char(36)
  name      String               @unique
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  sensitive Boolean              @default(false) // e.g. harassment → auto high priority, HR-only
  feedback  FeedbackSubmission[]

  @@map("feedback_categories")
}

model FeedbackPriority {
  id       String               @id @default(uuid()) @db.Char(36)
  key      String               @unique // LOW, MEDIUM, HIGH, CRITICAL
  name     String
  rank     Int
  feedback FeedbackSubmission[]

  @@map("feedback_priorities")
}

model FeedbackSubmission {
  id              String           @id @default(uuid()) @db.Char(36)
  reference       String           @unique // random, non-sequential
  ownerHmac       String? // HMAC(userId) so employee can list own items; not reversible. NULL for anonymous cases.
  anonymous       Boolean          @default(false) // true = no identity recorded anywhere; tracked with a secret key
  trackingKeyHash String? // HMAC of the one-time secret key (anonymous only); the key itself is never stored
  title           String           @db.VarChar(150)
  description     String           @db.Text
  categoryId      String           @db.Char(36)
  category        FeedbackCategory @relation(fields: [categoryId], references: [id])
  priorityId      String           @db.Char(36)
  priority        FeedbackPriority @relation(fields: [priorityId], references: [id])
  departmentId    String?          @db.Char(36)
  department      Department?      @relation(fields: [departmentId], references: [id])
  status          FeedbackStatus   @default(OPEN)
  submittedOn     DateTime         @db.Date // day precision only, reduces timing correlation
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resolvedAt      DateTime?

  identity    FeedbackIdentityMapping?
  attachments FeedbackAttachment[]
  assignments FeedbackAssignment[]
  history     FeedbackStatusHistory[]
  notes       FeedbackInternalNote[]
  messages    FeedbackMessage[]

  @@index([ownerHmac])
  @@index([anonymous])
  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([submittedOn])
  @@map("feedback_submissions")
}

// Only touched by src/server/identity.ts. RLS + separate DB role in migration.
model FeedbackIdentityMapping {
  feedbackId String             @id @db.Char(36)
  feedback   FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  userIdEnc  String             @db.VarChar(255) // AES-256-GCM(userId)
  createdAt  DateTime           @default(now())

  @@map("feedback_identity_mappings")
}

model FeedbackAttachment {
  id         String             @id @default(uuid()) @db.Char(36)
  feedbackId String             @db.Char(36)
  feedback   FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  storageKey String             @unique // random file name on disk
  mimeType   String
  sizeBytes  Int
  label      String // "Attachment 1" — original filename is discarded
  createdAt  DateTime           @default(now())

  @@map("feedback_attachments")
}

model FeedbackAssignment {
  id           String             @id @default(uuid()) @db.Char(36)
  feedbackId   String             @db.Char(36)
  feedback     FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  assigneeId   String             @db.Char(36)
  assignee     User               @relation("assignee", fields: [assigneeId], references: [id])
  assignedById String             @db.Char(36)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  @@index([assigneeId, active])
  @@index([feedbackId])
  @@map("feedback_assignments")
}

model FeedbackStatusHistory {
  id         String             @id @default(uuid()) @db.Char(36)
  feedbackId String             @db.Char(36)
  feedback   FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  fromStatus FeedbackStatus?
  toStatus   FeedbackStatus
  actorId    String?            @db.Char(36) // null when the employee (anonymous) acted
  remarks    String?            @db.Text
  createdAt  DateTime           @default(now())

  @@index([feedbackId])
  @@map("feedback_status_history")
}

model FeedbackInternalNote {
  id         String             @id @default(uuid()) @db.Char(36)
  feedbackId String             @db.Char(36)
  feedback   FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String             @db.Char(36)
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([feedbackId])
  @@map("feedback_internal_notes")
}

model FeedbackMessage {
  id         String             @id @default(uuid()) @db.Char(36)
  feedbackId String             @db.Char(36)
  feedback   FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author     MessageAuthor
  staffId    String?            @db.Char(36) // null for employee messages
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([feedbackId])
  @@map("feedback_messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  text      String    @db.VarChar(500) // reference + status only, never content or identity
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------- Audit (append-only, enforced by trigger) ----------
model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  actorId   String?  @db.Char(36)
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model IdentityAccessLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String   @db.Char(36)
  feedbackId String   @db.Char(36)
  reason     String   @db.VarChar(500)
  outcome    String // GRANTED | DENIED
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("identity_access_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ── Customer feedback forms (machines, service, cancellations) ─────────────────
// Staff build a form, then send each customer a personal one-use link by WhatsApp, email or copy.

enum CustomerFormStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model CustomerForm {
  id          String             @id @default(uuid()) @db.Char(36)
  title       String             @db.VarChar(120)
  intro       String             @default("") @db.VarChar(600) // shown above the questions
  thanks      String             @default("") @db.VarChar(300) // shown after submitting
  fields      Json // CustomerField[] (see src/lib/customer-forms.ts)
  status      CustomerFormStatus @default(DRAFT)
  shareCode   String?            @unique @db.VarChar(32) // open link anyone can use (/form/<code>); null = off
  createdById String?            @db.Char(36)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  sends CustomerFormSend[]

  @@index([status])
  @@map("customer_forms")
}

model CustomerFormSend {
  id           String       @id @default(uuid()) @db.Char(36)
  formId       String       @db.Char(36)
  form         CustomerForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  tokenHash    String       @unique @db.Char(64) // SHA-256 of the link token, used for lookup
  tokenEnc     String       @db.VarChar(255) // the token encrypted, so staff can copy the link again
  customerName String       @db.VarChar(120)
  company      String?      @db.VarChar(120)
  email        String?      @db.VarChar(254)
  phone        String?      @db.VarChar(32)
  machine      String?      @db.VarChar(160) // machine model / serial this feedback is about
  viaShare     Boolean      @default(false) // answered through the open link; details typed by the person, all optional
  sentById     String?      @db.Char(36)
  emailedAt    DateTime?
  openedAt     DateTime?
  respondedAt  DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  response CustomerFormResponse?

  @@index([formId, createdAt])
  @@map("customer_form_sends")
}

model CustomerFormResponse {
  id          String           @id @default(uuid()) @db.Char(36)
  sendId      String           @unique @db.Char(36)
  send        CustomerFormSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  fields      Json // copy of the questions as they were when answered
  answers     Json // { [fieldId]: string | number | string[] }
  submittedAt DateTime         @default(now())

  @@map("customer_form_responses")
}
